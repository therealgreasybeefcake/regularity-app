# Dependencies (reinstalled in the image)
node_modules
**/node_modules

# VCS
.git
.gitignore

# Secrets / local env — must NOT be baked into the image (Railway injects env)
.env
**/.env
**/.env*.local

# Native build output (regenerated by prebuild; not needed by the API)
apps/mobile/ios
apps/mobile/android
**/.expo
**/dist
**/.turbo

# Misc
*.log
.DS_Store
session-logs
.claude
