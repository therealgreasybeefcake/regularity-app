# --- Server ---
PORT=8787
# Public base URL of this API (used by BetterAuth for callbacks).
BETTER_AUTH_URL=http://localhost:8787
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=__CHANGE_ME__

# Comma-separated origins allowed to call the API / receive auth cookies.
# Include the web live-view origin and the native deep-link scheme.
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006,regularity://

# --- Database (Railway Postgres) ---
DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- OAuth (placeholders until real credentials are added) ---
# Google: GOOGLE_CLIENT_ID is the *Web* OAuth client (browser flow + the audience
# native id_tokens verify against). For NATIVE Google sign-in, also set the iOS and
# Android OAuth client ids so their id_tokens (aud = platform client id) verify.
GOOGLE_CLIENT_ID=__PLACEHOLDER__
GOOGLE_CLIENT_SECRET=__PLACEHOLDER__
GOOGLE_IOS_CLIENT_ID=__PLACEHOLDER__
GOOGLE_ANDROID_CLIENT_ID=__PLACEHOLDER__
# Apple: APPLE_CLIENT_ID is the Services ID (web flow). APPLE_BUNDLE_ID is the
# native app bundle id (the `aud` of native Sign in with Apple id_tokens); both
# audiences are accepted. Defaults to com.regularity.racetimer if unset.
APPLE_CLIENT_ID=__PLACEHOLDER__
APPLE_CLIENT_SECRET=__PLACEHOLDER__
APPLE_BUNDLE_ID=com.regularity.racetimer
