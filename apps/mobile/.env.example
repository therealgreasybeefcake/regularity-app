# URL of the Hono API. Defaults to http://localhost:8787 (works for the iOS
# simulator + web). For a PHYSICAL device, set this to your Mac's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# URL of the web app (shareable live-view links). Optional in development.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
