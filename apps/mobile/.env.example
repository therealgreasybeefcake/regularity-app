# URL of the Hono API.
#  - Cloud (default, works anywhere, no Mac needed):
#      EXPO_PUBLIC_API_URL=https://api-production-341fc.up.railway.app
#  - Local API dev (iOS simulator / web): http://localhost:8787
#  - Physical device + local API: your Mac's LAN IP, e.g. http://192.168.1.42:8787
EXPO_PUBLIC_API_URL=https://api-production-341fc.up.railway.app

# URL of the web app (shareable live-view links). Optional in development.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
