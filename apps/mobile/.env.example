# URL of the Hono API.
#  - Cloud (default, works anywhere, no Mac needed):
#      EXPO_PUBLIC_API_URL=https://api-production-341fc.up.railway.app
#  - Local API dev (iOS simulator / web): http://localhost:8787
#  - Physical device + local API: your Mac's LAN IP, e.g. http://192.168.1.42:8787
EXPO_PUBLIC_API_URL=https://api-production-341fc.up.railway.app

# URL of the web app (shareable live-view links). Optional in development.
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# --- Native Google Sign-In (public OAuth client IDs, NOT secrets) ---
# Create iOS + Android OAuth clients in Google Cloud (app id com.regularity.racetimer).
# Leave EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID blank to fall back to the browser OAuth flow.
#  - Web client id  = the same client the API verifies id_tokens against (server GOOGLE_CLIENT_ID)
#  - iOS client id  = the iOS OAuth client
#  - iOS URL scheme = the iOS client id reversed, e.g. com.googleusercontent.apps.1234-abcd
# These must also be set as EAS build env vars (eas.json `env` or the EAS dashboard)
# so production binaries pick them up — EAS Build does not read this .env file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
