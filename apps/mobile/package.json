    "@regularity/core": "workspace:*",
    "@regularity/schemas": "workspace:*",
    "better-auth": "^1.2.7",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.13",
    "expo-asset": "~55.0.8",
    "expo-audio": "~55.0.8",
