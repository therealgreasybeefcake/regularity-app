{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@regularity/core": [
        "../../packages/core/src"
      ],
      "@regularity/core/*": [
        "../../packages/core/src/*"
      ],
      "@regularity/schemas": [
        "../../packages/schemas/src"
      ],
      "@regularity/schemas/*": [
        "../../packages/schemas/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
