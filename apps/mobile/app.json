{
  "expo": {
    "name": "Regularity Race Timer",
    "slug": "regularity-race-timer",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Professional regularity race timing app with lap tracking, statistics, and PDF export",
    "primaryColor": "#1e40af",
    "owner": "greasybeefcake",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.regularity.racetimer",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "runtimeVersion": "39725300a5f85ff40b150953a03e572b6d781526",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "package": "com.regularity.racetimer",
      "permissions": [
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS"
      ],
      "runtimeVersion": "2f7e0f18e35966239f05422156dcc8be5e6dda45",
      "versionCode": 3
    },
    "scheme": "regularity",
    "updates": {
      "url": "https://u.expo.dev/9518c45d-1858-4d87-908f-106cd5784128"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-font",
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9518c45d-1858-4d87-908f-106cd5784128"
      }
    }
  }
}
