{
  "expo": {
    "name": "Regularity Race Timer",
    "slug": "regularity-race-timer",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Professional regularity race timing app with lap tracking, statistics, and PDF export",
    "primaryColor": "#1e40af",
    "owner": "greasybeefcake",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.regularity.racetimer",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "package": "com.regularity.racetimer",
      "permissions": [
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 2
    },
    "scheme": "regularity",
    "updates": {
      "url": "https://u.expo.dev/9518c45d-1858-4d87-908f-106cd5784128"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-asset",
      "expo-apple-authentication"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9518c45d-1858-4d87-908f-106cd5784128"
      }
    }
  }
}
