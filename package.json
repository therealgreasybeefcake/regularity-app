{
  "name": "regularity-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "mobile": "pnpm --filter @regularity/mobile start",
    "mobile:web": "pnpm --filter @regularity/mobile web",
    "api": "pnpm --filter @regularity/api dev",
    "update:prod": "cd apps/mobile && eas update --channel production --environment production",
    "update:preview": "cd apps/mobile && eas update --channel preview --environment preview"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "~5.9.2"
  }
}
